<Window x:Class="DupFinder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DupFinder.App.Resources"
        xmlns:svc="clr-namespace:DupFinder.App.Services"
        xmlns:views="clr-namespace:DupFinder.App.Views"
        Title="{x:Static res:Strings.AppTitle}"
        Width="1440" Height="880" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        DragOver="OnDragOver" Drop="OnDrop">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Шапка -->
    <DockPanel Grid.Row="0" Margin="4,0,4,14" LastChildFill="False">
      <Image DockPanel.Dock="Left" Source="/Assets/AppIcon-256.png" Width="40" Height="40"
             Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
      <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
        <TextBlock Text="{x:Static res:Strings.AppTitle}" FontSize="21" FontWeight="SemiBold"
                   Foreground="{StaticResource Text}"/>
        <TextBlock Text="{x:Static res:Strings.AppSubtitle}" FontSize="12" Margin="0,2,0,0"
                   Foreground="{StaticResource Muted}"/>
      </StackPanel>

      <!-- Версия и коммит: по запущенному окну видно, какая это сборка. -->
      <Border DockPanel.Dock="Right" VerticalAlignment="Center" CornerRadius="8"
              Background="{StaticResource Surface2}" Padding="10,5"
              ToolTip="{x:Static res:Strings.VersionTooltip}">
        <TextBlock Text="{x:Static svc:BuildInfo.ShortLabel}" FontSize="11"
                   Foreground="{StaticResource Muted}"/>
      </Border>
    </DockPanel>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="{x:Static res:Strings.TabScan}">
        <views:ScanView/>
      </TabItem>
      <TabItem Header="{x:Static res:Strings.TabResults}">
        <views:ResultsView/>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
