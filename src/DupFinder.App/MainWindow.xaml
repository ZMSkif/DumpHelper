<Window x:Class="DupFinder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DupFinder.App.Resources"
        xmlns:views="clr-namespace:DupFinder.App.Views"
        Title="{x:Static res:Strings.AppTitle}"
        Width="1440" Height="880" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        DragOver="OnDragOver" Drop="OnDrop">

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Шапка -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,4,14">
      <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentGrad}" Margin="0,0,12,0">
        <TextBlock Text="⧉" FontSize="22" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{x:Static res:Strings.AppTitle}" FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource TitleGrad}"/>
        <TextBlock Text="{x:Static res:Strings.AppSubtitle}" FontSize="12"
                   Foreground="{StaticResource Muted}"/>
      </StackPanel>
    </StackPanel>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="{x:Static res:Strings.TabScan}">
        <views:ScanView/>
      </TabItem>
      <TabItem Header="{x:Static res:Strings.TabResults}">
        <views:ResultsView/>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
