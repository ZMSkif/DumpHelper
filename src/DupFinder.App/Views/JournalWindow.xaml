<Window x:Class="DupFinder.App.Views.JournalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DupFinder.App.Resources"
        Title="{x:Static res:Strings.JournalTitle}"
        Width="920" Height="580" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

  <Border Background="{StaticResource Surface}" CornerRadius="14" Margin="14" Padding="20">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Border Background="{StaticResource Surface2}" CornerRadius="10"
                BorderBrush="{StaticResource Line}" BorderThickness="1">
          <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True" Margin="2">
            <DataGrid.Columns>
              <DataGridTextColumn Header="КОГДА" Binding="{Binding When}" Width="130"/>
              <DataGridTextColumn Header="ЧТО СДЕЛАНО" Binding="{Binding Action}" Width="160"/>
              <DataGridTextColumn Header="{x:Static res:Strings.ColumnFile}" Binding="{Binding Name}" Width="220"/>
              <DataGridTextColumn Header="{x:Static res:Strings.ColumnSize}" Binding="{Binding Size}" Width="90"/>
              <DataGridTextColumn Header="{x:Static res:Strings.ColumnFolder}" Binding="{Binding Directory}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource Muted}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
      </Grid>

      <WrapPanel Grid.Row="1" Margin="0,14,0,0">
        <Button Content="{x:Static res:Strings.LogRefresh}" Command="{Binding RefreshCommand}" Margin="0,0,6,0"/>
        <Button Content="{x:Static res:Strings.LogOpenFolder}" Style="{StaticResource GhostButton}"
                Command="{Binding OpenFolderCommand}"/>
      </WrapPanel>
    </Grid>
  </Border>
</Window>
