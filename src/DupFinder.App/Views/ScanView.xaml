<UserControl x:Class="DupFinder.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:DupFinder.App.Resources">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="340"/>
      <ColumnDefinition Width="10"/>
      <ColumnDefinition Width="*" MinWidth="340"/>
    </Grid.ColumnDefinitions>

    <!-- Левая карточка: папки и режим -->
    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Surface}" CornerRadius="14"
            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
            Effect="{StaticResource CardShadow}" Padding="18">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="{x:Static res:Strings.SectionFolders}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
          <ListBox Height="150"
                   ItemsSource="{Binding Scan.Roots}"
                   SelectedItem="{Binding Scan.SelectedRoot}"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
          <TextBlock Text="{x:Static res:Strings.FoldersHint}" Style="{StaticResource Hint}"/>
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Margin="0,4,6,4"
                    Content="{x:Static res:Strings.AddFolder}"
                    Command="{Binding Scan.AddFolderCommand}"/>
            <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                    Content="{x:Static res:Strings.RemoveFolder}"
                    Command="{Binding Scan.RemoveFolderCommand}"/>
          </Grid>

          <CheckBox Content="{x:Static res:Strings.IncludeSubfolders}" IsChecked="{Binding Scan.Recurse}"/>
          <CheckBox Content="{x:Static res:Strings.IncludeHidden}" IsChecked="{Binding Scan.IncludeHidden}"/>
          <CheckBox Content="{x:Static res:Strings.IncludeSystem}" IsChecked="{Binding Scan.IncludeSystem}"/>

          <TextBlock Text="{x:Static res:Strings.SectionMode}" Style="{StaticResource SectionHeader}"/>
          <ItemsControl ItemsSource="{Binding Scan.Modes}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton Style="{StaticResource ModeCard}"
                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                             IsEnabled="{Binding IsAvailable}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="{x:Static res:Strings.SectionReference}" Style="{StaticResource SectionHeader}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Margin="0,4,6,4" Text="{Binding Scan.ReferenceFolder, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="1" Content="…" Padding="12,6" Margin="0,4,4,4"
                    Command="{Binding Scan.PickReferenceCommand}"/>
            <Button Grid.Column="2" Content="✕" Padding="12,6" Style="{StaticResource GhostButton}"
                    Command="{Binding Scan.ClearReferenceCommand}"/>
          </Grid>
          <TextBlock Text="{x:Static res:Strings.ReferenceHint}" Style="{StaticResource Hint}"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <GridSplitter Grid.Row="0" Grid.Column="1" Width="10" HorizontalAlignment="Stretch"
                  ResizeBehavior="PreviousAndNext"/>

    <!-- Правая карточка: фильтры, правило оригинала, скорость -->
    <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource Surface}" CornerRadius="14"
            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
            Effect="{StaticResource CardShadow}" Padding="18">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="{x:Static res:Strings.SectionFilters}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
          <TextBlock Text="{x:Static res:Strings.FilterKind}" Style="{StaticResource FieldLabel}" Margin="0,0,0,0"/>
          <ComboBox ItemsSource="{Binding Scan.Kinds}" SelectedItem="{Binding Scan.SelectedKind}"
                    DisplayMemberPath="Label"/>

          <TextBlock Text="{x:Static res:Strings.MinSizeKb}" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding Scan.MinSizeKb, UpdateSourceTrigger=PropertyChanged}"/>

          <TextBlock Text="{x:Static res:Strings.MaxSizeMb}" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding Scan.MaxSizeMb, UpdateSourceTrigger=PropertyChanged}"/>

          <TextBlock Text="{x:Static res:Strings.ExcludeMasks}" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding Scan.ExcludeMasks, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="*.tmp; ~$*; thumbs.db"/>

          <TextBlock Text="{x:Static res:Strings.SectionOriginal}" Style="{StaticResource SectionHeader}"/>
          <ComboBox ItemsSource="{Binding Scan.OriginalRules}" SelectedItem="{Binding Scan.SelectedOriginalRule}"
                    DisplayMemberPath="Label"/>

          <TextBlock Text="{x:Static res:Strings.SectionPerformance}" Style="{StaticResource SectionHeader}"/>
          <TextBlock Text="{x:Static res:Strings.DiskType}" Style="{StaticResource FieldLabel}" Margin="0,0,0,0"/>
          <ComboBox ItemsSource="{Binding Scan.DiskKinds}" SelectedItem="{Binding Scan.SelectedDiskKind}"
                    DisplayMemberPath="Label"/>
          <CheckBox Content="{x:Static res:Strings.ConfirmBytewise}" IsChecked="{Binding Scan.ConfirmBytewise}"
                    Margin="0,10,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Запуск и прогресс -->
    <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource Surface}" CornerRadius="14"
            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
            Effect="{StaticResource CardShadow}" Padding="18,14" Margin="0,12,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource PrimaryButton}" MinWidth="180"
                Content="{x:Static res:Strings.Start}" Command="{Binding StartScanCommand}"/>
        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource GhostButton}" Margin="10,4,0,4"
                Content="{x:Static res:Strings.Cancel}" Command="{Binding CancelScanCommand}"/>

        <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0">
          <TextBlock Text="{Binding Scan.StatusText}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Scan.DetailText}" Foreground="{StaticResource Muted}" FontSize="11"/>
        </StackPanel>

        <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource GhostButton}"
                Content="{x:Static res:Strings.OpenLog}" Command="{Binding OpenLogCommand}"/>

        <ProgressBar Grid.Row="1" Grid.ColumnSpan="4" Margin="0,14,0,0"
                     Minimum="0" Maximum="100"
                     Value="{Binding Scan.ProgressValue, Mode=OneWay}"
                     IsIndeterminate="{Binding Scan.IsIndeterminate}">
          <ProgressBar.Style>
            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
              <!-- До первого запуска полосе нечего показывать, и она не должна мелькать. -->
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Scan.IsBusy}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ProgressBar.Style>
        </ProgressBar>
      </Grid>
    </Border>
  </Grid>
</UserControl>
