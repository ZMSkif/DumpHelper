<UserControl x:Class="DupFinder.App.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DupFinder.App.Converters"
             xmlns:res="clr-namespace:DupFinder.App.Resources">

  <UserControl.Resources>
    <conv:InverseBooleanConverter x:Key="NotBool"/>
  </UserControl.Resources>

  <Border Background="{StaticResource Surface}" CornerRadius="14"
          BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
          Effect="{StaticResource CardShadow}" Padding="14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Статистика -->
      <Border Grid.Row="0" Background="{StaticResource Surface2}" CornerRadius="8"
              Padding="12,8" Margin="0,0,0,8">
        <TextBlock Text="{Binding Results.StatisticsText}" FontSize="12" TextWrapping="Wrap"/>
      </Border>

      <!-- Действия -->
      <WrapPanel Grid.Row="1" Margin="0,0,0,8">
        <Button Margin="0,0,6,4" Content="{x:Static res:Strings.MarkCopies}"
                Command="{Binding Results.MarkCopiesCommand}"
                IsEnabled="{Binding Results.HasRows}"/>
        <Button Margin="0,0,6,4" Content="{x:Static res:Strings.MarkInvert}"
                Command="{Binding Results.InvertMarksCommand}"
                IsEnabled="{Binding Results.HasRows}"/>
        <Button Margin="0,0,6,4" Content="{x:Static res:Strings.MarkClear}"
                Command="{Binding Results.ClearMarksCommand}"
                IsEnabled="{Binding Results.HasRows}"/>
        <Button Margin="0,0,6,4" Content="{x:Static res:Strings.RevealInExplorer}"
                Command="{Binding Results.RevealSelectedCommand}"/>
        <Button Margin="0,0,6,4" Style="{StaticResource DangerButton}"
                Content="{x:Static res:Strings.DeleteMarked}"
                Command="{Binding Results.DeleteMarkedCommand}"
                IsEnabled="{Binding Results.HasMarked}"/>
      </WrapPanel>

      <!-- Фильтры -->
      <Grid Grid.Row="2" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="FilterBox" Grid.Column="0" Margin="0,0,6,0"
                 Text="{Binding Results.FilterText, UpdateSourceTrigger=PropertyChanged, Delay=50}"
                 ToolTip="{x:Static res:Strings.FilterPlaceholder}"/>
        <ComboBox Grid.Column="1" Width="170"
                  ItemsSource="{Binding Results.RoleFilters}"
                  SelectedItem="{Binding Results.SelectedRoleFilter}"
                  DisplayMemberPath="Label"/>
      </Grid>

      <!-- Таблица -->
      <Grid Grid.Row="3">
        <DataGrid x:Name="ResultsGrid"
                  ItemsSource="{Binding Results.Rows}"
                  SelectedItem="{Binding Results.SelectedRow}"
                  IsReadOnly="False"
                  PreviewKeyDown="OnGridPreviewKeyDown">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static res:Strings.RevealInExplorer}"
                        Command="{Binding Results.RevealSelectedCommand}"/>
              <MenuItem Header="{x:Static res:Strings.CopyPath}"
                        Command="{Binding Results.CopySelectedPathCommand}"/>
              <Separator/>
              <MenuItem Header="{x:Static res:Strings.MakeOriginal}"
                        Command="{Binding Results.MakeSelectedOriginalCommand}"/>
            </ContextMenu>
          </DataGrid.ContextMenu>

          <DataGrid.Columns>
            <DataGridTemplateColumn Width="40" CanUserSort="False" CanUserResize="False">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <CheckBox Margin="0" HorizontalAlignment="Center"
                            IsChecked="{Binding IsMarked, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{Binding IsProtected, Converter={StaticResource NotBool}, Mode=OneWay}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="{x:Static res:Strings.ColumnGroup}" Binding="{Binding GroupId}"
                                Width="46" IsReadOnly="True"/>
            <DataGridTemplateColumn Header="{x:Static res:Strings.ColumnRole}" Width="110"
                                    SortMemberPath="RoleText" CellTemplate="{StaticResource RoleCell}"/>
            <DataGridTextColumn Header="{x:Static res:Strings.ColumnFile}" Binding="{Binding Name}"
                                Width="230" IsReadOnly="True"/>
            <DataGridTextColumn Header="{x:Static res:Strings.ColumnMatch}" Binding="{Binding MatchText}"
                                Width="140" IsReadOnly="True"/>
            <DataGridTextColumn Header="{x:Static res:Strings.ColumnKind}" Binding="{Binding KindText}"
                                Width="95" IsReadOnly="True"/>
            <DataGridTextColumn Header="{x:Static res:Strings.ColumnPixels}" Binding="{Binding PixelsText}"
                                Width="90" IsReadOnly="True"/>
            <DataGridTextColumn Header="{x:Static res:Strings.ColumnSize}" Binding="{Binding SizeText}"
                                SortMemberPath="Length" Width="90" IsReadOnly="True"/>
            <DataGridTextColumn Header="{x:Static res:Strings.ColumnModified}"
                                Binding="{Binding Modified, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                Width="125" IsReadOnly="True"/>
            <DataGridTextColumn Header="{x:Static res:Strings.ColumnFolder}" Binding="{Binding Directory}"
                                Width="*" IsReadOnly="True"/>
          </DataGrid.Columns>
        </DataGrid>

        <!-- Пустое состояние -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Results.HasRows}" Value="False">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="⧉" FontSize="56" Foreground="#2A3140" HorizontalAlignment="Center"/>
          <TextBlock Text="{x:Static res:Strings.EmptyResultsTitle}" FontSize="16" FontWeight="SemiBold"
                     Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,2"/>
          <TextBlock Text="{x:Static res:Strings.EmptyResultsHint}" Foreground="{StaticResource Faint}"
                     HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</UserControl>
