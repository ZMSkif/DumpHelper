<Window x:Class="DupFinder.App.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DupFinder.App.Resources"
        Title="{x:Static res:Strings.LogTitle}"
        Width="960" Height="620" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

  <Border Background="{StaticResource Surface}" CornerRadius="14" Margin="14" Padding="14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="{Binding FileLabel}" Foreground="{StaticResource Muted}"
                 FontSize="11" TextTrimming="CharacterEllipsis" Margin="2,0,2,8"/>

      <Border Grid.Row="1" Background="{StaticResource Surface2}" CornerRadius="10" Padding="2">
        <TextBox Text="{Binding Text, Mode=OneWay}"
                 IsReadOnly="True" IsReadOnlyCaretVisible="True"
                 FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                 Background="Transparent" BorderThickness="0"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"/>
      </Border>

      <WrapPanel Grid.Row="2" Margin="0,10,0,0">
        <Button Content="{x:Static res:Strings.LogRefresh}" Command="{Binding RefreshCommand}" Margin="0,0,6,0"/>
        <Button Content="{x:Static res:Strings.LogCopy}" Command="{Binding CopyAllCommand}" Margin="0,0,6,0"/>
        <Button Content="{x:Static res:Strings.LogOpenFolder}" Style="{StaticResource GhostButton}"
                Command="{Binding OpenFolderCommand}"/>
      </WrapPanel>
    </Grid>
  </Border>
</Window>
