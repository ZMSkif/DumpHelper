<Window x:Class="DupFinder.App.Views.DeleteConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DupFinder.App.Resources"
        Title="{x:Static res:Strings.DeleteConfirmTitle}"
        Width="880" Height="600" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

  <Border Background="{StaticResource Surface}" CornerRadius="14" Margin="14" Padding="20">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="{Binding Header}" FontSize="15" FontWeight="SemiBold"
                 TextWrapping="Wrap" Margin="0,0,0,14"/>

      <Border Grid.Row="1" Background="{StaticResource Surface2}" CornerRadius="10"
              BorderBrush="{StaticResource Line}" BorderThickness="1">
        <DataGrid ItemsSource="{Binding Allowed}" IsReadOnly="True" Margin="2">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static res:Strings.ColumnFile}" Binding="{Binding Name}" Width="260"/>
            <DataGridTextColumn Header="{x:Static res:Strings.ColumnSize}" Binding="{Binding Size}" Width="100"/>
            <DataGridTextColumn Header="{x:Static res:Strings.ColumnFolder}" Binding="{Binding Directory}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- Пропущенные: то, ради чего это окно и сделано -->
      <Expander Grid.Row="2" Margin="0,12,0,0" IsExpanded="True"
                Visibility="{Binding HasRefused, Converter={StaticResource BoolToVisibility}}">
        <Expander.Header>
          <TextBlock Text="{Binding SkippedHeader}" FontWeight="SemiBold"
                     Foreground="{StaticResource Warn}"/>
        </Expander.Header>
        <Border Background="{StaticResource Surface2}" CornerRadius="10" Margin="0,8,0,0"
                BorderBrush="{StaticResource Line}" BorderThickness="1" MaxHeight="160">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Refused}" Margin="12,10">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Medium" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Note}" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Expander>

      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="{x:Static res:Strings.DeleteConfirmCancel}" Style="{StaticResource GhostButton}"
                MinWidth="110" Margin="0,0,10,0" Click="OnCancel"/>
        <Button Content="{x:Static res:Strings.DeleteConfirmProceed}" Style="{StaticResource DangerButton}"
                MinWidth="180" Click="OnProceed" IsEnabled="{Binding CanProceed}"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
